# API
VITE_API_URL=https://your-railway-url.up.railway.app/api
VITE_GITHUB_CLIENT_ID=your_github_client_id
GITHUB_TOKEN=your_github_token

# CORS (backend) — set to your frontend's production URL; defaults to git-garden.vercel.app
ALLOWED_ORIGIN=https://git-garden.vercel.app

# EmailJS Configuration
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# DB Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=database_name

# Resend email (optional — verification emails skipped if not set)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=GitGarden <onboarding@resend.dev>
APP_URL=https://git-garden.vercel.app